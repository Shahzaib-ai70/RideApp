[Unit]
Description=Sawaari VPS API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sawaari-source
ExecStartPre=/usr/bin/node --env-file=/etc/sawaari/api.env /opt/sawaari-source/server/migrate.mjs
ExecStart=/usr/bin/node --env-file=/etc/sawaari/api.env /opt/sawaari-source/server/api.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sawaari/private-documents
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
