[Unit]
Description=Sawaari VPS Admin API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sawaari-source
EnvironmentFile=/etc/sawaari/admin.env
ExecStart=/usr/bin/node /opt/sawaari-source/server/admin-api.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
