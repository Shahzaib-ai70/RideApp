# Mapbox public token for the website's GL JS map, Geocoding, and Directions.
# Use a public token only (pk.*); apply website URL restrictions before production.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Separate Mapbox public token for native Directions and reverse geocoding.
# Use a public token (pk.*) with only required API scopes; do not use a secret token.
EXPO_PUBLIC_MAPBOX_MOBILE_ACCESS_TOKEN=

# Server-only TomTom key, used by the local search proxy and VPS API.
# It is never bundled into the app.
TOMTOM_API_KEY_SERVER=

# Optional WhatsApp Business support number in international format, digits only.
# Example format: 923XXXXXXXXX. Leave blank until the official number is ready.
EXPO_PUBLIC_WHATSAPP_SUPPORT_NUMBER=

# Native builds call the VPS API directly. Web builds use the same-origin /api proxy.
EXPO_PUBLIC_API_URL=https://sawaari.online/api
