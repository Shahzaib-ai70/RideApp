# Native keys: use separate Google Cloud keys because Android and iOS application
# restrictions are mutually exclusive. Enable only the matching Maps SDK for each.
# Restrict Android to package com.sawaari.pakistan and your signing certificate.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
# Restrict iOS to bundle identifier com.sawaari.pakistan.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=

# Mapbox public token for the website's GL JS map, Search Box, Geocoding, and Directions.
# Use a public token only (pk.*); apply URL restrictions before production deployment.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Server key is configured only in /etc/sawaari/api.env on the VPS
# (GOOGLE_MAPS_SERVER_API_KEY). Never add it to this Expo .env file.
# For local web location search only, set TOMTOM_API_KEY_SERVER in .env.
# It is read by the localhost-only search proxy and is never bundled into the app.
TOMTOM_API_KEY_SERVER=

# Optional WhatsApp Business support number in international format, digits only.
# Example format: 923XXXXXXXXX. Leave blank until the official number is ready.
EXPO_PUBLIC_WHATSAPP_SUPPORT_NUMBER=

# Native builds call the VPS API directly. Web builds use the same-origin /api proxy.
EXPO_PUBLIC_API_URL=https://sawaari.online/api
