# Mobile key: enable Maps SDK for Android/iOS and restrict it to this app's package
# (com.sawaari.pakistan) and bundle identifier (com.sawaari.pakistan).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional web key: enable Maps JavaScript API, Places API (New), and Routes API.
# Without this key, web preview uses OpenStreetMap-based map/search/routing.
# Restrict the key to your local and production website referrers.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# Optional WhatsApp Business support number in international format, digits only.
# Example format: 923XXXXXXXXX. Leave blank until the official number is ready.
EXPO_PUBLIC_WHATSAPP_SUPPORT_NUMBER=

# Native builds call the VPS API directly. Web builds use the same-origin /api proxy.
EXPO_PUBLIC_API_URL=https://sawaari.online/api
